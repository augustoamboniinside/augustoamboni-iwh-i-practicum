doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Pets Custom Object Records

    a(href="/update-cobj") Add to this table

    table
      thead
        tr
          th Name
          th Species
          th Age
      tbody
        each pet in pets
          tr
            td= pet.properties.name
            td= pet.properties.species
            td= pet.properties.age
